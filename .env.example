# Copy to .env.local and fill in for local development. Never commit real values.
# On Vercel these are injected automatically by the Upstash/KV integration.
#
# Server-side only (the /api routes in the multiplayer phase). Never import these
# into /public or anything the browser loads.

# Upstash REST API, called with fetch. Used for both reads and writes.
KV_REST_API_URL=
KV_REST_API_TOKEN=
